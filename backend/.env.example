# Local PostgreSQL connection for the helpdesk database.
# Replace password with your postgres user's password.
DATABASE_URL="postgresql://postgres:password@localhost:5432/helpdesk?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-string"
BETTER_AUTH_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Initial admin created by `bun run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
